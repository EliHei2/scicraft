# Every path this project reads or writes, set once. Scripts source this file; no other
# file hard-codes a path. Any line can be overridden from the environment.
# Fill the [bracketed] values on each machine; this file holds no secrets.

PROJECT_ROOT="${PROJECT_ROOT:-[absolute path of this project on this machine]}"

# Raw stores, read in place (linked into data/raw/ and listed in PROVENANCE.md).
RAW_ROOT="${RAW_ROOT:-[absolute path of the raw data store]}"

# Persistent results. On a remote machine, put this on a backed-up project area, never on scratch.
RESULTS_ROOT="${RESULTS_ROOT:-$PROJECT_ROOT/results}"

# Throwaway: smoke tests, checks, temporary files.
SCRATCH_ROOT="${SCRATCH_ROOT:-$PROJECT_ROOT/scratch}"

# Remote copy of the code, used by scripts/sync.sh (user@host:/absolute/path/).
REMOTE="${REMOTE:-{{REMOTE}}}"

# Where the remote writes results (pulled back with scripts/sync.sh down).
REMOTE_RESULTS="${REMOTE_RESULTS:-[user@host:/absolute/path/of/remote/results/]}"

export PROJECT_ROOT RAW_ROOT RESULTS_ROOT SCRATCH_ROOT REMOTE REMOTE_RESULTS
